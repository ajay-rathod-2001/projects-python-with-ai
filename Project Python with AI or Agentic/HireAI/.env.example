# HireAI Environment Configuration Example

APP_NAME="HireAI – Intelligent Recruitment & Assessment Platform"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Security & Authentication (Generate random secret for production)
SECRET_KEY=replace-with-a-very-secure-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default is embedded SQLite; set to PostgreSQL for production)
DATABASE_URL=sqlite:///./storage/hireai.db
# DATABASE_URL=postgresql://hireai_user:hireai_secure_password@localhost:5432/hireai_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# Optional LLM API Keys (Enables enhanced generative features)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Execution Limits
CODE_EXEC_TIMEOUT_SECONDS=5
CODE_EXEC_MEMORY_MB=128
DOCKER_SANDBOX_ENABLED=false
