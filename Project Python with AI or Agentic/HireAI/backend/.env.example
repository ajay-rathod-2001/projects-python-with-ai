# Application Configuration
APP_NAME="AI Career Intelligence"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# CORS Configuration (allowed desktop/local origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,tauri://localhost"

# Database Configuration
DATABASE_URL="sqlite:///./storage/career_intelligence.db"

# Storage Locations
RESUME_STORAGE_DIR="./storage/resumes"
JOB_STORAGE_DIR="./storage/job_descriptions"
REPORT_STORAGE_DIR="./storage/reports"

# Document Processing & Upload Limits
MAX_UPLOAD_SIZE_BYTES=15728640  # 15 MB
ALLOWED_FILE_EXTENSIONS="pdf,docx,doc,txt,rtf"

# AI / NLP Settings
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
SPACY_MODEL="en_core_web_sm"
TESSERACT_CMD=""  # Optional: Path to tesseract.exe if not in PATH
LIBREOFFICE_PATH=""  # Optional: Path to soffice.exe if not in PATH
