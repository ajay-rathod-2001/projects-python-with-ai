ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL + pgvector
DATABASE_URL=postgresql+asyncpg://workos:workos_secret_pass@localhost:5432/workos_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Security
JWT_SECRET_KEY=super_secret_jwt_key_change_in_production_32bytes_minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI & LLM Provider
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
EMBEDDING_MODEL=text-embedding-004

# Integrations
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

